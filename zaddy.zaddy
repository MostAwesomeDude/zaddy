.grammar ZADDY

ZADDY := '.grammar' ID:name PRULE*:rules WS
       -> py.Compound('class ' + name + 'Parser(object)', [
                py.Compound('def __init__(self, s)',
                            [py.Statement('self.s = s; self.lastMatch = []')]),
                py.Statement('def parse(self): return self.parse' + name + '(0)')
              ] + *rules) ;

ZR := ID:name '='
      ( FIELDS:fs -> zephyr.Product(name, fs)
      / CONSTRUCTOR:con ( '|' CONSTRUCTOR )*:cons
        ( 'attributes' FIELDS )?:attrs -> zephyr.Sum(name, attrs, con, cons) ) ;
CONSTRUCTOR := ID:tag FIELDS?:args -> zephyr.Con(tag, args) ;
FIELDS := '(' FIELD:f ( ',' FIELD )*:fs ')' -> f + fs ;
FIELD := ID:ty ID?:name '?' -> zephyr.Option(ty, name)
       / ID:ty ID?:name '*' -> zephyr.Sequence(ty, name)
       / ID:ty ID?:name     -> zephyr.Id(ty, name) ;

PRULE := ID:name ':=' PEXPR1:expr ';'
       -> [py.Statement('@cached'),
           py.Compound('def parse' + name + '(self, i)',
           [py.Statement('st = []')] + expr + [py.Statement('return i, rv')])] ;
PEXPR1 := PEXPR2:this '/' PEXPR1:that -> peg.Choice(this, that)
        / PEXPR2 ;
PEXPR2 := PEXPR3:exprs '->' PPROD1:prod -> peg.Production(exprs, prod)
        / PEXPR3 ;
PEXPR3 := PEXPR4*:exprs -> peg.Sequence(exprs) ;
PEXPR4 := PEXPR5:expr ':' ID:name -> peg.Capture(expr, name)
        / PEXPR5 ;
PEXPR5 := '&' PEXPR6:expr -> peg.Positive(expr)
        / '!' PEXPR6:expr -> peg.Negative(expr)
        / PEXPR6 ;
PEXPR6 := PEXPR7:expr '*' -> peg.Any(expr)
        / PEXPR7:expr '?' -> peg.Maybe(expr)
        / PEXPR7 ;
PEXPR7 := '.range(' NUMBER:l ':' NUMBER:u ')' -> peg.Range(l, u)
        / '.any'                              -> peg.AnyChar
        / NUMBER:c                            -> peg.Char(c)
        / ID:name                             -> peg.Call(name)
        / STRING:s                            -> peg.Token(s)
        / '(' PEXPR1:expr ')'                 -> expr ;
PPROD1 := PPROD2:this '+' PPROD1:that -> peg.Plus(this, that)
        / PPROD2:this '%' PPROD1:that -> peg.Mod(this, that)
        / PPROD2 ;
PPROD2 := '*' PPROD3:prod -> peg.Flatten(prod)
        / PPROD3 ;
PPROD3 := ID:ty '.' ID:con
          '(' PPROD1:prod ( ',' PPROD1 )*:prods ')' -> peg.Con(ty, con, [prod] + prods)
        / ID:ty '.' ID:con                          -> peg.Con(ty, con, [])
        / '[]'                                      -> peg.List([])
        / '[' PPROD1:expr ( ',' PPROD1 )*:exprs ']' -> peg.List([expr] + exprs)
        / ID:s                                      -> peg.Name(s)
        / STRING:s                                  -> peg.String(s)
        / '(' PPROD1:prod ')'                       -> prod ;

WS := ( 9 / 10 / 13 / 32 )* ;
DIGIT := .range(48:57) ;
ALPHA := .range(65:90) / .range(97:122) ;
STRING := WS 39 ( !( 10 / 13 / 39 ) .any )*:cs 39 -> cs % '' ;
NUMBER := WS DIGIT:d DIGIT*:ds -> ([d] + ds) % '' ;
ID := WS ALPHA:c ( ALPHA / DIGIT )*:cs -> ([c] + cs) % '' ;
