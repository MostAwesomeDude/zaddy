.syntax ZADDY

OUT1 = '*'     .out('ob += tb' .nl)
     / STRING  .out('ob += ' 39 * 39 .nl)
     / NUMBER  .out('ob += chr(' * ')' .nl)
     / '.lm+'  .out('ms[-1] += 1' .nl)
     / '.lm-'  .out('if ms[-1]: ms[-1] -= 1' .nl)
     / '.lm?'  .out('ms.append(ms[-1])' .nl)
     / '.lm!'  .out('ms.pop()' .nl)
     / '.nl'   .out(
       'lb += " " * (ms[-1] * 4) + ob + chr(10)' .nl
       'ob = ""' .nl
     ) ;
OUTPUT = '.out' '(' $OUT1 ')' ;

CX3 = NUMBER / SQUOTE .litchr ;
CX2 = CX3 ( ':' .out(* ' <= ord(self.s[i]) <= ') CX3 .out(*)
          / .empty .out('ord(self.s[i]) == ' *) ) ;
CX1 = .out('pf = (i < len(self.s)) and ') CX2
      $( '!' .out(' or ') CX2 ) .out(.nl) .post { ?pf } ;

SCAN = .pre { +pf } {
         .pre { +tf } { .out('tb += self.s[i]' .nl) }
         .pre { ?tf } { .out('if tf: tb += self.s[i]' .nl) }
         .out('i += 1' .nl)
       }
       .pre { ?pf } {
         .out('if pf:' .nl .lm+)
         .pre { +tf } { .out('tb += self.s[i]' .nl) }
         .pre { ?tf } { .out('if tf: tb += self.s[i]' .nl) }
         .out('i += 1' .nl .lm-)
       } ;
SUB = ID .out(
        'rv = self.parse' * '(i, tf, ms[:], tb, ob, lb)' .nl
        'pf = rv is not failed' .nl
        'if pf: i, ms[-1], tb, ob, lb = rv.t' .nl
      ) .top ;

SET = .pre { ~+pf } { .out('pf = True' .nl) } .post { +pf } ;

SAVE = .out('saved.append((i, tf, ms[-1], tb, ob, lb))' .nl) ;
BACKUP = .out('i, tf, ms[-1], tb, ob, lb = saved[-1]' .nl) ;
COMMIT = .out('saved.pop()' .nl) ;

TX3 = ( '.token'
        .out('tb = ""' .nl)
        .pre { ~+tf } { .out('tf = True' .nl) } .post { +tf }
      / '.tokout'
        .pre { ~-tf } { .out('tf = False' .nl) } .post { -tf }
      / '$' SET .out('while pf:' .nl .lm+) .post { +pf } TX3 .out(.lm-) .post { -pf } ) SET
    / '.empty' SET
    / '.not(' CX1 ')' .out('pf = (i < len(self.s)) and not pf' .nl) .post { ?pf } SCAN
    / '.any(' CX1 ')' SCAN
    / SUB
    / '(' TX1 ')' ;
TX2 = .out(.lm?) TX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf }
      $( TX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf } )
      .out(.lm!) ;
TX1 = SAVE TX2
      $( '/' .out('if not pf:' .nl .lm+) .post { -pf }
         BACKUP TX2 .post { ?pf } .out(.lm-) ) COMMIT ;
TR = ID .out(
       'def parse' * '(self, i, tf, ms, tb, ob, lb):' .nl .lm+
       'k = "' * '", i, tf, ms[-1], tb, ob, lb' .nl
       'if k in self.cache: return self.cache[k]' .nl
       'self.cache[k] = failed' .nl
       'saved = []' .nl
     )
     ':' .top SET TX1 ';'
     .out(
       'if pf:' .nl .lm+
       'self.cache[k] = Succeeded((i, ms[-1], tb, ob, lb))' .nl
       'self.lastMatch.append((k[0], k[1]))' .nl .lm-
       'return self.cache[k]' .nl .lm-
     ) ;

TVAR = '~' .out('(not ') TVAR .out(')')
     / '?' ID .out('(self.a' * ' == 0)')
     / '+' ID .out('(self.a' * ' == 1)')
     / '-' ID .out('(self.a' * ' == 2)') ;
AVAR = '?' ID .out('self.a' * ' = 0' .nl)
     / '+' ID .out('self.a' * ' = 1' .nl)
     / '-' ID .out('self.a' * ' = 2' .nl) ;
EX3 = SUB
    / STRING .out(
      'while i < len(self.s) and self.s[i] in (" " + chr(10)): i += 1' .nl
      'stop = i + len("' * '")' .nl
      'if stop > len(self.s): pf = False' .nl
      'else: pf = self.s[i:stop] == "' * '"' .nl
      'if pf: i = stop' .nl
    ) .post { ?pf }
    / '(' EX1 ')'
    / '.pre' '{' .out('if ') TVAR
      $( ',' .out(' and ') TVAR ) .out(':' .nl .lm+ 'pass' .nl) '}'
      '{' EX1 '}' .out(.lm-)
    / '.post' '{' AVAR $( ',' AVAR ) '}'
    / '.fork'
    / '.join'
    / '.top' .out('self.top()' .nl)
    / '.empty' SET
    / '.litchr' SET .out(
      'tb = str(ord(self.s[i]))' .nl
      'i += 1' .nl
    )
    / '.pass' .out('i = 0' .nl)
    / '$' SET .out('while pf:' .nl .lm+) .post { +pf }
      EX3 .out(.lm-) .post { -pf } SET ;
EX2 = .out(.lm?)
      ( EX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf } / OUTPUT )
      $( EX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf } / OUTPUT )
      .out(.lm!) .post { ?pf } ;
EX1 = SAVE EX2
      $( '/' .out('if not pf:' .nl .lm+) .post { -pf }
         BACKUP EX2 .post { ?pf } .out(.lm-) ) COMMIT ;

PR = ID .out(
       'def parse' * '(self, i, tf, ms, tb, ob, lb):' .nl .lm+
       'k = "' * '", i, tf, ms[-1], tb, ob, lb' .nl
       'if k in self.cache: return self.cache[k]' .nl
       'self.cache[k] = failed' .nl
       'saved = []' .nl
     )
     '=' .top SET EX1 ';'
     .out(
       'if pf:' .nl .lm+
       'self.cache[k] = Succeeded((i, ms[-1], tb, ob, lb))' .nl
       'self.lastMatch.append((k[0], k[1]))' .nl .lm-
       'return self.cache[k]' .nl .lm-
     ) ;

TY = 'bool' .out('0') ;
DR = ID ':' .out('self.a' * ' = ') TY ';' .out(.nl) ;

PROLOGUE = .out(
             'from rpython.rlib.rfile import create_stdio' .nl
             'class Status(object): pass' .nl
             'class Failed(Status): pass' .nl
             '# i, ms[-1], tb, ob, lb' .nl
             'class Succeeded(Status):' .nl .lm+
             'def __init__(self, t): self.t = t' .nl .lm-
             'failed = Failed()' .nl
           ) ;

ZR = ID '=' ZTY ;
ZTY = PRODUCTTY / SUMTY ;
PRODUCTTY = FIELDS ;
SUMTY = CONSTRUCTOR $( '|' CONSTRUCTOR )
        ( 'attributes' FIELDS / .empty ) ;
CONSTRUCTOR = ID ( FIELDS / .empty ) ;
FIELDS = '(' FIELD $( ',' FIELD ) ')' ;
FIELD = ID ( '?' / '*' / .empty ) ( ID / .empty ) ;

ZADDY = PROLOGUE
        $( ( '.grammar' / '.syntax' ) ID
           .out(
             'def main(argv):' .nl .lm+
             'stdin, stdout, stderr = create_stdio()' .nl
             'parser = ' * 'Parser(stdin.read())' .nl
             'status = parser.parse()' .nl
             'if status is failed:' .nl .lm+
             'start = max(len(parser.lastMatch) - 5, 0)' .nl
             'for k, i in parser.lastMatch[start:]:' .nl .lm+
             'lineNumber = parser.s.count(chr(10), 0, i) + 1' .nl
             't = k, i, lineNumber' .nl
             'stderr.write(("Last successful match:' 39 '%s, %d (line %d)' 39 '" % t) + chr(10))' .nl .lm-
             'return 1' .nl .lm-
             'else:' .nl .lm+
             '_, _, _, _, lb = status.t' .nl
             'stdout.write(lb)' .nl
             'return 0' .nl .lm- .lm-
             'def target(driver, *args):' .nl .lm+
             'driver.exe_name = "' * '".lower() + "c"' .nl
             'return main, None' .nl .lm-
             'class ' * 'Parser(object):' .nl .lm+
             'def __init__(self, s): self.s = s; self.lastMatch = []; self.cache = {}; self.top()' .nl
             'def parse(self):' .nl .lm+
             'self.top()' .nl
             '# i, tf, ms, tb, ob, lb' .nl
             'return self.parse' * '(0, False, [0], "", "", "")' .nl .lm-
           )
           $( PRULE / PR ) ( '.tokens' $TR / .empty )
           .out('def top(self):' .nl .lm+ 'pass' .nl)
           ( '.domain' $DR / .empty ) .out(.lm-)
         / '.algebra' ID $ZR
         / '.tiles' ID $TIR
         )
        '.end' ;

TIR = ID '=' TCLAUSE $( '|' TCLAUSE ) ';' ;
TCLAUSE = TIPATT '->' $TIX1 ;
TIPATT = TIPATTS / ID ( TIPATTS / .empty ) ;
TIPATTS = '(' TIVAL $( ',' TIVAL ) ')' ;
TIVAL = '[]' / ID ;
TIX1 = '*' / '.lm-' / '.lm+' / NUMBER / STRING
     / ID ( ':(' $TIX1 ')' / .empty ) ;

ZSAVE = .out('saved.append((i, rv))' .nl) ;
ZBACKUP = .out('i, rv = saved[-1]' .nl) ;
ZCOMMIT = .out('if pf: saved.pop()' .nl) ;

PRULE = ID .out(
          'def parse' * '(self, i):' .nl .lm+
          'k = "' * '", i' .nl
          'if k in self.cache: return self.cache[k]' .nl
          'self.cache[k] = failed' .nl
          'saved = []' .nl
        )
        ( ':str' .out('rv = ""' .nl) / .empty .out('rv = None' .nl) )
        ':=' PEXPR1 ';' .out(
          'if rv:' .nl .lm+
          'self.cache[k] = Succeeded((i, rv))' .nl
          'self.lastMatch.append(k)' .nl .lm-
          'return self.cache[k]' .nl .lm-
        ) ;
PEXPR1 = ZSAVE PEXPR2
         $( '/' .out('if not rv:' .nl .lm+)
            ZBACKUP PEXPR2 ZCOMMIT .out(.lm-) ) ;
PEXPR2 = .out(.lm?)
         $( .out('if rv:' .nl .lm+ 'pass' .nl) PEXPR3 ( ':' ID .out(* ' = rv' .nl) / .empty ) )
         ( '->' .out('rv = ') PPROD1 .out(.nl) / .empty )
         .out(.lm!) ;
PPROD1 = PPROD2 ( '+' .out(' + ') PPROD2 / .empty ) ;
PPROD2 = ( ( ID '.' .out(* '.') / .empty ) ID .out(*) / .empty )
         '(' .out('(') PPROD1 $( ',' .out(', ') PPROD1) ')' .out(')')
       / ID .out(*) ;
PEXPR3 = '&' ZSAVE PEXPR4 ZBACKUP
       / '!' ZSAVE PEXPR4 ZBACKUP
       / PEXPR4 ;
PEXPR4 = .out(
           'pf = first = True' .nl
           'rvs = []' .nl
           'while pf:' .nl .lm+
         )
         PEXPR5
         .out('pf = bool(rv)' .nl)
         ( '+' .out('pf = pf or not first' .nl)
         / '*' )
         .out('first = False' .nl)
         .out(.lm-)
       / ZSAVE PEXPR5 '?'
         .out('if not rv:' .nl .lm+) ZBACKUP .out(.lm-)
         ZCOMMIT
       / PEXPR5 ;
PEXPR5 = '.range(' NUMBER .out('if ' * ' <= ord(self.s[i]) <= ')
         ':' NUMBER ')' .out(* ': rv = self.s[i]; i += 1' .nl)
       / '.any' .out('rv = self.s[i]; i += 1' .nl)
       / NUMBER .out('if ord(self.s[i]) == ' * ': rv = chr(' * '); i += 1' .nl)
       / ID .out(
           'st = self.parse' * '(i)' .nl
           'if st is not failed: i, rv = st.t' .nl
         )
       / STRING .out(
           'l = len("' * '")' .nl
           'if self.s[i:i + l] == "' * '": rv = "' * '"; i += l' .nl
         )
       / '(' PEXPR1 ')' ;

ZZR := ID '=' ZTY ;
ZZTY := PRODUCTTY / SUMTY ;
ZPRODUCTTY := FIELDS ;
ZSUMTY := CONSTRUCTOR ( '|' CONSTRUCTOR )*
        ( 'attributes' FIELDS )? ;
ZCONSTRUCTOR := ID:tag FIELDS?:args -> zephyr.Con(tag, args) ;
ZFIELDS := '(' FIELD ( ',' FIELD )* ')' ;
ZFIELD := ID:ty ID?:name '?' -> zephyr.Option(ty, name)
        / ID:ty ID?:name '*' -> zephyr.Sequence(ty, name)
        / ID:ty ID?:name     -> zephyr.Id(ty, name) ;

ZPRULE := ID ':=' PEXPR1 ';' ;
ZPEXPR1 := PEXPR2 ( '/' PEXPR2 )* ;
ZPEXPR2 := ( PEXPR3 ( ':' ID )? )* ( '->' PPROD1 )? ;
ZPPROD1 := PPROD2 ( '+' PPROD2 )? ;
ZPPROD2 := ID '.' ID '(' PPROD1 ( ',' PPROD1 )* ')' / ID ;
ZPEXPR3 := '&' PEXPR4:expr -> peg.Positive(expr)
         / '!' PEXPR4:expr -> peg.Negative(expr)
         / PEXPR4 ;
ZPEXPR4 := PEXPR5:expr '*' -> peg.Any(expr)
         / PEXPR5:expr '?' -> peg.Maybe(expr)
         / PEXPR5 ;
ZPEXPR5 := '.range(' NUMBER ':' NUMBER ')'
         / '.any' / NUMBER / ID / STRING / '(' PEXPR1 ')' ;

ZWS := ( 9 / 10 / 13 / 32 )* ;
ZDIGIT := .range(48:57) ;
ZALPHA := .range(65:90) / .range(97:122) ;
ZSQUOTE := WS 39 ;
ZSTRING := WS 39 ( !( 10 / 13 / 39 ) .any )*:cs 39 -> cs ;
ZNUMBER := WS ZDIGIT:d ZDIGIT*:ds -> d + ds ;
ZID := WS ALPHA:c ( ALPHA / DIGIT )*:cs -> c + cs ;

.tokens

WS     : $.any(9!10!13!32) ;
DIGIT  : .any('0:'9) ;
ALPHA  : .any('A:'Z!'a:'z) ;
SQUOTE : WS .any(39) ;
STRING : WS .any(39) .token $.not(10!13!39) .tokout .any(39) ;
NUMBER : WS .token DIGIT $DIGIT .tokout ;
ID     : WS .token ALPHA $( ALPHA / DIGIT ) .tokout ;

.domain

pf : bool ;
tf : bool ;

.algebra peg

expr = Exactly(string)
     | Sequence(expr*)
     | Choice(expr, expr)
     | Any(expr)
     | Some(expr)
     | Maybe(expr)
     | Positive(expr)
     | Negative(expr)

.algebra zephyr

ty = Sum(string name, field* attrs, constructor con, constructor* cons)
   | Product(string name, field comp, field* comps)
constructor = Con(string tag, field* args)
field = Id(string ty, string? name)
      | Option(string ty, string? name)
      | Sequence(string ty, string? name)

.algebra py

stmt = Compound(string head, stmt* block)
     | Conditional(string test, stmt* block)
     | Statement(string line)
py = (stmt* lines)

.tiles out

py = (lines) -> lines:( * ) ;
stmt = Compound(head, []) -> head ': pass' 10
     | Compound(head, block) -> head ':' 10 .lm+ block .lm-
     | Conditional(test, []) ->
     | Conditional(test, block) -> 'if ' test ':' 10 .lm+ block .lm-
     | Statement(line) -> line 10 ;

.end
