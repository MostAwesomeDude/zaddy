.syntax PROGRAM

OUT1 = '*'     .out('self.ob += self.tb' .nl)
     / STRING  .out('self.ob += ' 39 * 39 .nl)
     / NUMBER  .out('self.ob += chr(' * ')' .nl)
     / '#'     .out('self.ob += self.unique()' .nl)
     / '.lm+'  .out('self.m += 1' .nl)
     / '.lm-'  .out('if self.m: self.m -= 1' .nl)
     / '.nl'   .out(
       'print " " * (self.m * 2) + self.ob' .nl
       'self.ob = ""' .nl
     ) ;
OUTPUT = '.out' '('
         .pre { ?of } { .out('if self.of:' .nl .lm+) $OUT1 .out(.lm-) }
         .pre { -of } { .o- $OUT1 .o+ }
         ')' ;

CX3 = NUMBER / SQUOTE .litchr ;
CX2 = CX3 ( ':' .out(* ' <= ord(s.get()) <= ') CX3 .out(*)
          / .empty .out('ord(s.get()) == ' *) ) ;
CX1 = .out('self.pf = ') CX2 $( '!' .out(' or ') CX2 ) .out(.nl) .post { ?pf } ;

SCAN = .pre { +pf } {
         .pre { +tf } { .out('self.tb += s.get()' .nl) }
         .pre { ?tf } { .out('if self.tf: self.tb += s.get()' .nl) }
         .out('s.advance(1)' .nl)
       }
       .pre { ?pf } {
         .out('if self.pf:' .nl .lm+)
         .pre { +tf } { .out('self.tb += s.get()' .nl) }
         .pre { ?tf } { .out('if self.tf: self.tb += s.get()' .nl) }
         .out('s.advance(1)' .nl .lm-)
       } ;
SUB = ID .out(
        'self.stack.append(("' * '", self.l1))' .nl
        'self.l1 = ""' .nl
        'self.parse' * '(s)' .nl
        'self.stack.pop()' .nl
      ) .top ;

SET = .pre { ~+pf } { .out('self.pf = True' .nl) } .post { +pf } ;

TX3 = ( '.token'
        .out('self.tb = ""' .nl)
        .pre { ~+tf } { .out('self.tf = True' .nl) } .post { +tf }
      / '.tokout'
        .pre { ~-tf } { .out('self.tf = False' .nl) } .post { -tf }
      / '$' SET .out('while self.pf:' .nl .lm+) .post { +pf } TX3 .out(.lm-) .post { -pf } ) SET
    / '.empty' SET
    / '.not(' CX1 ')' .out('self.pf = not self.pf' .nl) .post { ?pf } SCAN
    / '.any(' CX1 ')' SCAN
    / SUB
    / '(' TX1 ')' ;
TX2 = TX3 .out('if self.pf:' .nl .lm+ 'pass' .nl) .post { +pf }
      $( TX3 .pre { ~+pf } { .out('if not self.pf: return' .nl) } .post { +pf } )
      .out(.lm-) ;
TX1 = TX2
      $( '/' .out('if not self.pf:' .nl .lm+) .post { -pf }
         TX2 .out(.lm-) .post { ?pf } ) ;
TR = ID .out('def parse' * '(self, s):' .nl .lm+) ':' .top TX1 ';' .out(.lm-) ;

TVAR = '~' .out('(not ') TVAR .out(')')
     / '?' ID .out('(self.a' * ' == 0)')
     / '+' ID .out('(self.a' * ' == 1)')
     / '-' ID .out('(self.a' * ' == 2)') ;
AVAR = '?' ID .out('self.a' * ' = 0' .nl)
     / '+' ID .out('self.a' * ' = 1' .nl)
     / '-' ID .out('self.a' * ' = 2' .nl) ;
EX3 = SUB
    / STRING .out(
      's.eatWhitespace()' .nl
      'self.pf = s.matches("' * '")' .nl
      'if self.pf: s.advance(len("' * '"))' .nl
    ) .post { ?pf }
    / '(' EX1 ')'
    / '.pre' '{' .out('if ') TVAR
      $( ',' .out(' and ') TVAR ) .out(':' .nl .lm+ 'pass' .nl) '}'
      '{' EX1 '}' .out(.lm-)
    / '.post' '{' AVAR $( ',' AVAR ) '}'
    / '.fork'
    / '.join'
    / '.top' .out('self.top()' .nl)
    / '.empty' SET
    / '.litchr' SET .out(
      'self.tb = str(ord(s.get()))' .nl
      's.advance(1)' .nl
    )
    / '.o+' .pre { ~+of } { .out('self.of = True' .nl) } .post { +of }
    / '.o-' .pre { ~-of } { .out('self.of = False' .nl) } .post { -of }
    / '.pass' .out('s.i = 0' .nl)
    / '$' SET .out('while self.pf:' .nl .lm+) .post { +pf }
      EX3 .out(.lm-) .post { -pf } SET ;
EX2 = ( EX3 .out('if self.pf:') .post { +pf } / OUTPUT .out('if True:') )
      .out(.nl .lm+ 'pass' .nl)
      $( EX3
         .pre { ~+pf } { .out('if not self.pf: self.error(s.i)' .nl) } .post { +pf }
         / OUTPUT )
      .out(.lm-) .post { ?pf } ;
EX1 = EX2 $( '/' .out('if not self.pf:' .nl .lm+) EX2 .out(.lm-) ) ;

PR = ID .out('def parse' * '(self, s):' .nl .lm+) '=' .top EX1 ';' .out(.lm-) ;

TY = 'bool' .out('0') ;
DR = ID ':' .out('self.a' * ' = ') TY ';' .out(.nl) ;

PROGRAM = '.syntax' ID .out(
            'class ' * 'Parser(object):' .nl .lm+
            'u = 0' .nl
            'pf = tf = False' .nl
            'of = True' .nl
            'l1 = tb = ""' .nl
            'm = 0' .nl
            'ob = ""' .nl
            'def __init__(self): self.top(); self.stack = []' .nl
            'def parse(self, s): self.top(); return self.parse' * '(s)' .nl
            'def unique(self):' .nl .lm+
            'if not self.l1: self.l1 = str(self.u); self.u += 1' .nl
            'return self.l1' .nl .lm-
            'def error(self, i): raise ValueError("meh")' .nl
          )
          $PR '.tokens' $TR
          .out('def top(self):' .nl .lm+ 'pass' .nl) '.domain' $DR .out(.lm-)
          '.end' ;

.tokens

WS     : $.any(9!10!13!32) ;
DIGIT  : .any('0:'9) ;
ALPHA  : .any('A:'Z!'a:'z) ;
SQUOTE : WS .any(39) ;
STRING : WS .any(39) .token $.not(10!13!39) .tokout .any(39) ;
NUMBER : WS .token DIGIT $DIGIT .tokout ;
ID     : WS .token ALPHA $( ALPHA / DIGIT ) .tokout ;

.domain

pf : bool ;
tf : bool ;
of : bool ;

.end
