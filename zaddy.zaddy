.signature py

statement = Statement(string line)
          | Imp(string module, string names)
          | Ret(string expr)
          | RaiseIf(string test)
          | ContIf(string test)
          | Compound(string head, statement* block)
          | Conditional(string test, statement* block)
          | Handler(statement* block, statement* handler)

.signature peg

pattern = NamePatt(string name)
        | TuplePatt(pattern* ps)

expr = Null
     | Token(string s)
     | Call(string s)
     | Sequence(expr* exprs)
     | Choice(expr this, expr that)
     | Any(expr expr)
     | Some(expr expr)
     | Maybe(expr expr)
     | Positive(expr expr)
     | Negative(expr expr)
     | Capture(expr expr, pattern patt)
     | Production(expr expr, prod prod)

.signature zephyr

signature = Signature(string name, type* tys)
type = Product(string name, field* fs)
     | Sum(string name, string* attrs, constructor con, constructor* cons)
constructor = Con(string tag, field* args)
field = Id(string ty, string name)
      | Option(string ty, string name)
      | Sequence(string ty, string name)

.signature rules

patt = IgnorePatt
     | VarPatt(string n)
     | StrPatt(string s)
     | StructPatt(string ns, string func, patt* vars)
     | EmptyListPatt
     | ListPatt(patt* ps)
     | ListHeadPatt(patt head, patt* ps)
     | ListTailPatt(patt tail, patt* ps)
     | ListMidPatt(patt head, patt tail, patt* ps)
production = VarProd(string name)
           | ConstProd(string name)
           | StrProd(string s)
           | CharProd(int n)
           | StructProd(string ns, string func, production* ps)
           | ListProd(production* ps)
           | ListHeadProd(production head, production* ps)
           | ListTailProd(production tail, production* ps)
           | ListMidProd(production head, production tail, production* ps)
           | FlattenOp(production p)
           | LengthOp(production p)
           | JoinOp(string s, production p)
           | ConcatOp(production p, production* ps)
           | GenSym(string s)
rule = Rewrite(string name, patt root, production* prods)
     | Let(string name, production p)

.signature char

set = Any
    | Exactly(char c)
    | Range(set l, set u)
    | Call(string n)
    | Complement(set s)
    | Either(set l, set r)

.signature ops

.signature ds

rep = Make
    | Union(rep l, rep r)
    | Find(rep handle)
    | MakeStr(str s)
    | MakeList(rep* handles)
str = FindStr(rep handle)
list = FindList(rep handle)

.signature cq

query = Query(var* head, rel* body)
rel = Relation(string ns, string table, var* vars)
var = Var(string name)

.signature gj

sub = EmptySub

.rules

pyStatement @ py.Statement(L)       ==> [.line(L)] ;
pyImp       @ py.Imp(M, Ns)         ==> [.line('from ' M ' import ' Ns)] ;
pyRet       @ py.Ret(E)             ==> [.line('return ' E)] ;
pyRaiseIf   @ py.RaiseIf(T)         ==> [.line('if ' T ': raise ParseError("no reason")')] ;
pyContIf    @ py.ContIf(T)          ==> [.line('if ' T ': continue')] ;
pyCompPass  @ py.Compound(H, [])    ==> [.line(H ': pass')] ;
pyCompBlock @ py.Compound(H, B)     ==> [.line(H ':'), .block(*[*B, [.line('pass')]])] ;
pyCondEmpty @ py.Conditional(T, []) ==> [] ;
pyCondBlock @ py.Conditional(T, B)  ==> [.line('if ' T ':'), .block(*B)] ;
pyHandEmpty @ py.Handler(B, [])     ==> [] ;
pyHandBlock @ py.Handler(B, H)      ==> [.line('try:'), .block(*B),
                                         .line('except ParseError as pe:'), .block(*H)] ;


pegNamePatt  @ peg.NamePatt(Name) ==> 'v' Name ;
pegTuplePatt @ peg.TuplePatt(Ps)  ==> '(' .join(Ps, ', ') ')' ;

let save       := py.Statement('st.append(i)') ;
let backup     := py.Statement('i = st.pop()') ;
let boundcheck := py.RaiseIf('i >= len(self.s)') ;
let skipws     := py.Statement('while i < len(self.s) and ord(self.s[i]) in [9, 10, 13, 32]: i += 1') ;

pegSeq      @ peg.Sequence(Es)     ==> *Es ;
pegCap      @ peg.Capture(E, P)    ==> [E…, py.Statement(P ' = rv')] ;
pegProd     @ peg.Production(E, P) ==> [E…, py.Statement('rv = ' P)] ;
pegCall     @ peg.Call(S)          ==> [py.Statement('i, rv = self.parse' S '(i)')] ;
pegChoice   @ peg.Choice(L, R)     ==> [save, py.Handler(L, [backup, R…])] ;
pegToken    @ peg.Token(S)         ==> [skipws, boundcheck,
                                        py.Statement('assert i >= 0'),
                                        py.RaiseIf('self.s[i:i + ' #S '] != u"' S '"'),
                                        py.Statement('self.lastMatch.append((u"TOKEN ' S '", i, i + ' #S '))'),
                                        py.Statement('rv = self.uf.makeStr(u"' S '"); i += ' #S)] ;
pegAny      @ peg.Any(E)           ==> [py.Statement('rvs = []'),
                                        py.Compound('while True',
                                            [save,
                                             py.Handler([E…, py.Statement('rvs.append(rv)')],
                                                        [backup, py.Statement('break')])]),
                                        py.Statement('rv = rel.uf.makeList(rvs)')] ;
pegSome     @ peg.Some(E)          ==> *[peg.Any(E), [py.RaiseIf('not len(rvs)')]] ;

pegMaybe    @ peg.Maybe(E)         ==> [save, py.Handler(E, [py.Statement('rv = 0'), backup])] ;
pegPos      @ peg.Positive(E)      ==> [save,
                                        py.Handler([E…, py.Statement('rv = True')],
                                                   [py.Statement('rv = False')]),
                                        backup,
                                        py.RaiseIf('not rv')] ;
pegNeg      @ peg.Negative(E)      ==> [save,
                                        py.Handler([E…, py.Statement('rv = True')],
                                                   [py.Statement('rv = False')]),
                                        backup,
                                        py.RaiseIf('rv')] ;


zSig    @ zephyr.Signature(N, T)    ==> [py.Statement(N 'Cons = []'),
                                         py.Compound('class ' N 'Rels(Rels)', *[[
                                             py.Statement('cons = ' N 'Cons'),
                                             py.Compound('def __init__(self, uf)', [
                                                py.Statement('self.uf = uf'),
                                                py.Compound('for n in unrolled' N 'Cons', [
                                                    py.Statement('setattr(self, n, {})'),
                                                    py.Statement('setattr(self, "hash" + n, {})')
                                                ])
                                             ]),
                                             py.Compound('def rebuild(self)', [
                                                py.Compound('for n in unrolled' N 'Cons', [
                                                    py.Statement('rebuildRel(self.uf, getattr(self, n))'),
                                                    py.Statement('rebuildHash(self.uf, getattr(self, "hash" + n))')
                                                ])
                                             ])
                                         ], *T]),
                                         py.Statement('unrolled' N 'Cons = unrolling_iterable(' N 'Cons[:])'),
                                         py.Statement('allRels.append(("' N '", ' N 'Rels))')] ;
zProd   @ zephyr.Product(N, Fs)     ==> [py.Statement('# product ' N)] ;
zSum    @ zephyr.Sum(N, A, C, Cs)   ==> *[C, *Cs] ;
zConF   @ zephyr.Con(T, A)          ==> [py.Statement('cons.append("' T '")'),
                                         py.Compound('def make' T '(self, ' .join(A, ', ') ')', [
                                             py.Statement('self.dirty' T ' = True'),
                                             py.Statement('k = (' .join(A, ', ') ')'),
                                             py.Statement('if k in self.hash' T ': return self.hash' T '[k]'),
                                             py.Statement('rv = self.uf.make()'),
                                             py.Statement('self.' T '[(rv, ' .join(A, ', ') ')] = None'),
                                             py.Statement('self.hash' T '[k] = rv'),
                                             py.Ret('rv')
                                         ])
                                     ] ;
zOpt    @ zephyr.Option(T, N)       ==> N ;
zSeq    @ zephyr.Sequence(T, N)     ==> N ;
zId     @ zephyr.Id(T, N)           ==> N ;


charAny     @ char.Any           ==> 'True' ;
charExactly @ char.Exactly(C)    ==> 'c == ' C ;
charRange   @ char.Range(L, U)   ==> L ' <= c <= ' U ;
charCall    @ char.Call(N)       ==> 'self.cls' N '(c)' ;
charComp    @ char.Complement(S) ==> 'not (' S ')' ;
charEither  @ char.Either(L, R)  ==> '(' L ') or (' R ')' ;


rPattIg @ rules.IgnorePatt                 ==> '_' ;
rPattV  @ rules.VarPatt(N)                 ==> 'v' N ;
rPattS  @ rules.StrPatt(S)                 ==> 'u' 39 S 39 ;
rPattSt @ rules.StructPatt(Ns, F, Vs)      ==> 'for (vRoot, ' .join(Vs, ', ') ') in rel.' Ns '.' F ;
rPattLE @ rules.EmptyListPatt              ==> 'beEmpty' ;
rPattLL @ rules.ListPatt(Ps)               ==> .join(Ps, ', ') ;
rPattLH @ rules.ListHeadPatt(H, Ps)        ==> 'listhead' H .join(Ps, ', ') ;
rPattLT @ rules.ListTailPatt(T, Ps)        ==> 'listtail' T .join(Ps, ', ') ;
rPattLM @ rules.ListMidPatt(H, T, Ps)      ==> 'listmid' H T .join(Ps, ', ') ;
rProdV  @ rules.VarProd(Name)              ==> 'v' Name ;
rProdC  @ rules.ConstProd(Name)            ==> 'rel.const' Name ;
rProdS  @ rules.StrProd(S)                 ==> 'uf.makeStr(u' 39 S 39 ')' ;
rProdCh @ rules.CharProd(N)                ==> 'uf.makeStr(unichr(' N '))' ;
rProdSt @ rules.StructProd(Ns, F, Ps)      ==> 'rel.' Ns '.make' F '(' .join(Ps, ', ') ')' ;
rProdL  @ rules.ListProd(Ps)               ==> 'uf.makeList([' .join(Ps, ', ') '])' ;
rProdLH @ rules.ListHeadProd(H, Ps)        ==> 'uf.makeList(uf.findList(' H ') + [' .join(Ps, ', ') '])' ;
rProdLT @ rules.ListTailProd(T, Ps)        ==> 'uf.makeList([' .join(Ps, ', ') '] + uf.findList(' T '))' ;
rProdLM @ rules.ListMidProd(H, T, Ps)      ==> 'uf.makeList(uf.findList(' H ') + [' .join(Ps, ', ') '] + uf.findList(' T '))' ;
rProdOF @ rules.FlattenOp(P)               ==> 'rel.builtin.makeFlatten(' P ')' ;
rProdOL @ rules.LengthOp(P)                ==> 'rel.builtin.makeLength(' P ')' ;
rProdOJ @ rules.JoinOp(S, P)               ==> 'rel.builtin.makeJoin(uf.makeStr(u"' S '"), ' P ')' ;
rProdOE @ rules.ConcatOp(P, [])            ==> P ;
rProdOC @ rules.ConcatOp(P, Ps)            ==> 'rel.builtin.makeConcat(' P ', uf.makeList([' .join(Ps, ', ') ']))' ;
rGenSym @ rules.GenSym(S)                  ==> 'uf.makeStr(rel.gensym(' S '))' ;
rRule   @ rules.Rewrite(Name, RootFor, Ps) ==> [py.Statement('@rewrite("builtin", "py", "rules", "peg", "char", "zephyr")'),
                                                py.Compound('def ' Name '(uf, rel)', [
                                                    py.Statement('q = []'),
                                                    py.Statement('beEmpty = uf.makeList([])'),
                                                    py.Compound(RootFor, [
                                                        py.Compound('try', [
                                                            py.ContIf('len(uf.findList(beEmpty))'),
                                                            py.Statement('uf.union(vRoot, ' .join(Ps, ', ') ')'),
                                                            py.Statement('q.append(vRoot)')
                                                        ]),
                                                        py.Statement('except NoResults: continue')
                                                    ]),
                                                    py.Ret('len(q)')
                                                ])] ;
rLet    @ rules.Let(Name, P)               ==> [py.Statement('@let'),
                                                py.Statement('def let' Name '(uf, rel): rel.const' Name ' = ' P)] ;

.grammar ZADDY

class Whitespace = 9 | 10 | 13 | 32 ;
class Digit = .range(48:57) ;
class Upper = .range(65:90) ;
class Lower = .range(97:122) ;
class Alpha = Upper | Lower ;
class Alphanumeric = Alpha | Digit ;
class Quote = 39 ;
class Quoted = ~( 10 | 13 | 39 ) ;
class Ellipsis = 8230 ;

token WS = Whitespace* ;
token Number = Digit+ ;
token Id = Alpha Alphanumeric* ;
token PVar = Upper Alphanumeric* ;
token PConst = Lower+ ;
token ZTId = Lower Alphanumeric* ;
token ZCId = Upper Alphanumeric* ;
token Quote = Quote ;
token Quoted = Quoted* ;
token Ellipsis = Ellipsis ;

STRING := WS Quote Quoted:Q Quote -> Q ;
ID := WS Id ;

SIGNATURE := '.signature' ID:Name ZTY*:Tys -> zephyr.Signature(Name, *Tys) ;
ZTY := ID:Name '='
      ( FIELDS:Fs -> [zephyr.Product(Name, Fs)]
        / ZCON:Con ( '|' ZCON )*:Cons
          ( 'attributes' FIELDS:Attrs -> [zephyr.Sum(Name, Attrs, Con, Cons)]
          / -> [zephyr.Sum(Name, [], Con, Cons)] ) ) ;
ZCON := WS ( ZCId:Tag FIELDS:Args -> zephyr.Con(Tag, Args)
           / ZCId:Tag -> zephyr.Con(Tag, []) ) ;
FIELDS := '(' FIELD:F ( ',' FIELD )*:Fs ')' -> *[[F], Fs] ;
FIELD := WS ( ZTId:Ty '?' ID:Name -> zephyr.Option(Ty, Name)
            / ZTId:Ty '*' ID:Name -> zephyr.Sequence(Ty, Name)
            / ZTId:Ty ID:Name     -> zephyr.Id(Ty, Name) ) ;

RULES := '.rules' ( CHRULE / CHLET )*:Hs -> *Hs ;
CHRULE := ID:Name '@' WS CPATT:Root '==>' CPRODS:Prods ';'
       -> rules.Rewrite(Name, Root, Prods) ;
CHLET := 'let' ID:Name ':=' CPROD1:P ';' -> rules.Let(Name, P) ;
CPATTS := WS CPATT:P ( ',' WS CPATT )*:Ps -> *[[P], Ps] ;
PATTDOTS := WS PVar:N Ellipsis -> rules.VarPatt(N) ;
CPATT := '_'                                 -> rules.IgnorePatt
       / '[]'                                -> rules.EmptyListPatt
       / '[' PATTDOTS:Head ',' CPATTS:Ps ',' PATTDOTS:Tail ']'
         -> rules.ListMidPatt(Head, Tail, Ps)
       / '[' PATTDOTS:Head ',' CPATTS:Ps ']' -> rules.ListHeadPatt(Head, Ps)
       / '[' CPATTS:Ps ',' PATTDOTS:Tail ']' -> rules.ListTailPatt(Tail, Ps)
       / '[' CPATTS:Ps ']'                   -> rules.ListPatt(Ps)
       / STRING:S                            -> rules.StrPatt(S)
       / ID:Ns '.' ID:Func '(' CPATTS:Ps ')' -> rules.StructPatt(Ns, Func, Ps)
       / ID:Ns '.' ID:Func                   -> rules.StructPatt(Ns, Func, [])
       / PVar:Name !Ellipsis                 -> rules.VarPatt(Name) ;
CPRODS := CPROD1:P ( ',' CPROD1 )*:Ps -> *[[P], Ps] ;
CPROD1 := WS CPROD2:P ( WS CPROD2 )+:Ps -> rules.ConcatOp(P, Ps)
        / WS CPROD2 ;
CPROD2 := STRING:S                            -> rules.StrProd(S)
        / Number:N                            -> rules.CharProd(N)
        / '.gensym(' STRING:S ')'             -> rules.GenSym(S)
        / '.gensym'                           -> rules.GenSym('gs')
        / '#' CPROD2:P                        -> rules.LengthOp(P)
        / '*' CPROD2:P                        -> rules.FlattenOp(P)
        / '*(' CPROD1:P ')'                   -> rules.FlattenOp(P)
        / '.line(' CPROD1:P ')'               -> rules.StructProd('builtin', 'Line', [P])
        / '.block(' CPROD1:P ')'              -> rules.StructProd('builtin', 'Block', [P])
        / '.join(' CPROD1:P ',' STRING:S ')'  -> rules.JoinOp(S, P)
        / '[]'                                -> rules.ListProd([])
        / '[' PATTDOTS:Head ',' CPRODS:Ps ',' PATTDOTS:Tail ']'
          -> rules.ListMidProd(Head, Tail, Ps)
        / '[' PATTDOTS:Head ',' CPRODS:Ps ']' -> rules.ListHeadProd(Head, Ps)
        / '[' CPRODS:Ps ',' PATTDOTS:Tail ']' -> rules.ListTailProd(Tail, Ps)
        / '[' CPRODS:Ps ']'                   -> rules.ListProd(Ps)
        / PVar:Name !Ellipsis                 -> rules.VarProd(Name)
        / PConst:Name !Ellipsis !'.'          -> rules.ConstProd(Name)
        / ID:Ns '.' ID:Func '(' CPRODS:Ps ')' -> rules.StructProd(Ns, Func, Ps)
        / ID:Ns '.' ID:Func                   -> rules.StructProd(Ns, Func, []) ;

GRAMMAR := '.grammar' ID:Name ( PCLASS / PTOKEN / PRULE )*:Rules
        -> [py.Compound('def target(driver, *args)',
               [py.Statement('driver.exe_name = "' Name '".lower() + "c"'),
                py.Ret('main, None')]),
            py.Compound('class ' Name 'Parser(object)',
               *[[py.Compound('def __init__(self, s, uf)',
                    [py.Statement('self.s = s; self.uf = uf'),
                     py.Statement('self.lastMatch = []'),
                     py.Statement('for name in unrolledRels: setattr(self, name, frozenRels[name](uf))'),
                     py.Statement('for l in unrolledLets: l(uf, self)')
                  ]),
                py.Statement('gs = 0'),
                py.Compound('def gensym(self, s)', [
                    py.Statement('self.gs += 1'),
                    py.Ret('s + str(self.gs).decode("utf-8")')
                ]),
                py.Compound('def parse(self)',
                    [py.Ret('self.parse' Name '(0)')])],
               *Rules]),
            py.Statement('MainParser = ' Name 'Parser')] ;

PCLASS := 'class' ID:Name '=' CLASSEXPR1:C ';'
       -> [py.Compound('def cls' Name '(self, c)', [py.Ret(C)])] ;
CLASSEXPR1 := CLASSEXPR2:L '|' CLASSEXPR1:R -> char.Either(L, R)
            / CLASSEXPR2 ;
CLASSEXPR2 := '.any'                                    -> char.Any
            / '.range(' WS Number:L ':' WS Number:U ')' -> char.Range(L, U)
            / '~' CLASSEXPR2:S                          -> char.Complement(S)
            / '(' CLASSEXPR1:S ')'                      -> S
            / WS Number:C                               -> char.Exactly(C)
            / ID:N                                      -> char.Call(N) ;

PTOKEN := 'token' ID:Name '=' PSCAN+:Scans ';'
       -> [py.Compound('def parse' Name '(self, i)',
                       *[[boundcheck, py.Statement('start = i; assert start >= 0')],
                       *Scans,
                       [py.Statement('rv = self.uf.makeStr(self.s[start:i])'),
                        py.Statement('self.lastMatch.append((u"TOKEN ' Name '", start, i))'),
                        py.Ret('i, rv')]])] ;
PSCAN := ID:Cls '*' -> [py.Statement('while i < len(self.s) and self.cls' Cls '(ord(self.s[i])): i += 1')]
       / ID:Cls '+' -> [py.RaiseIf('i >= len(self.s) or not self.cls' Cls '(ord(self.s[i]))'),
                        py.Statement('while i < len(self.s) and self.cls' Cls '(ord(self.s[i])): i += 1')]
       / ID:Cls     -> [py.RaiseIf('i >= len(self.s) or not self.cls' Cls '(ord(self.s[i]))'),
                        py.Statement('i += 1')] ;

PRULE := ID:Name ':=' PEXPR1:Expr ';'
       -> [py.Statement('@cached'),
           py.Compound('def parse' Name '(self, i)',
           *[[py.Statement('rel = self; uf = self.uf; st = []')], Expr, [py.Ret('i, rv')]])] ;
PEXPR1 := PEXPR2:This '/' PEXPR1:That -> peg.Choice(This, That)
        / PEXPR2 ;
PEXPR2 := PEXPR3:Exprs '->' CPROD1:Prod -> peg.Production(Exprs, Prod)
        / PEXPR3 ;
PEXPR3 := PEXPR4*:Exprs -> peg.Sequence(Exprs) ;
PEXPR4 := PEXPR5:Expr ':' PPATT:P -> peg.Capture(Expr, P)
        / PEXPR5 ;
PPATT := '(' PPATT:P ( ',' PPATT )*:Ps -> peg.TuplePatt(*[[P], Ps])
       / ID:Name                       -> peg.NamePatt(Name) ;
PEXPR5 := '&' PEXPR6:Expr -> peg.Positive(Expr)
        / '!' PEXPR6:Expr -> peg.Negative(Expr)
        / PEXPR6 ;
PEXPR6 := PEXPR7:Expr '*' -> peg.Any(Expr)
        / PEXPR7:Expr '+' -> peg.Some(Expr)
        / PEXPR7:Expr '?' -> peg.Maybe(Expr)
        / PEXPR7 ;
PEXPR7 := '(' PEXPR1:Expr ')'   -> Expr
        / STRING:S              -> peg.Token(S)
        / ID:Name               -> peg.Call(Name) ;

ZADDY := WS ( RULES / SIGNATURE / GRAMMAR )*:Clss WS
      -> *[[py.Imp('collections', 'defaultdict'),
          py.Imp('rpython.rlib.rfile', 'create_stdio'),
          py.Imp('rpython.rlib.objectmodel', 'specialize, r_dict'),
          py.Imp('rpython.rlib.unroll', 'unrolling_iterable'),
          py.Imp('rpython.rlib.listsort', 'make_timsort_class'),
          py.Compound('class Result(object)', []),
          py.Compound('class Failed(Result)', []),
          py.Statement('failed = Failed()'),
          py.Compound('def cached(f, cacheCount=[0])', [
              py.Statement('attr = "t" + str(cacheCount[0]); cacheCount[0] += 1'),
              py.Statement('name = f.__name__'),
              py.Statement('uname = unicode(name)'),
              py.Compound('class CacheResult(Result)', [
                  py.Statement('def __init__(self, i, rv): setattr(self, attr, (i, rv))')
              ]),
              py.Statement('cache = {}'),
              py.Compound('def deco(self, i)', [
                  py.Statement('key = i'),
                  py.RaiseIf('key in cache and cache[key] is failed'),
                  py.Statement('elif key in cache: return getattr(cache[key], attr)'),
                  py.Statement('cache[key] = failed'),
                  py.Statement('i, rv = f(self, i)'),
                  py.Statement('cache[key] = CacheResult(i, rv)'),
                  py.Statement('self.lastMatch.append((uname, key, i))'),
                  py.Ret('i, rv')
              ]),
              py.Statement('deco.__name__ = name'),
              py.Ret('deco')
          ]),
          py.Statement('ruleNames = []'),
          py.Statement('letNames = []'),
          py.Compound('def let(f)', [
              py.Statement('letNames.append(f)'),
              py.Ret('f')
          ]),
          py.Statement('triggers = defaultdict(list)'),
          py.Compound('def rewrite(*args)', [
              py.Compound('def deco(f)', [
                  py.Statement('name = f.__name__'),
                  py.Statement('ruleNames.append((name, f))'),
                  py.Statement('for rel in args: triggers[rel].append(name)'),
                  py.Ret('f')
              ]),
              py.Ret('deco')
          ]),
          py.Statement('@specialize.call_location()'),
          py.Compound('def flatten(xs)', [
              py.Statement('rv = []'),
              py.Statement('for x in xs: rv.extend(x)'),
              py.Ret('rv')
          ]),
          py.Compound('def intersect(l, r)', [
              py.Statement('rv = []'),
              py.Compound('for x in r', [
                  py.Statement('if x in l: rv.append(x)')
              ]),
              py.Ret('rv')
          ]),
          py.Statement('def listEq(l, r): return l == r'),
          py.Compound('def listHash(l)', [
              py.Statement('rv = 0'),
              py.Statement('for x in l: rv += x'),
              py.Ret('rv')
          ]),
          py.Compound('class UF(object)', [
              py.Compound('def __init__(self)', [
                  py.Statement('self.uf = [0]'),
                  py.Statement('self.handle2str = {}'),
                  py.Statement('self.str2handle = {}'),
                  py.Statement('self.handle2list = {}'),
                  py.Statement('self.list2handle = r_dict(listEq, listHash)')
              ]),
              py.Compound('def make(self)', [
                  py.Statement('rv = len(self.uf)'),
                  py.Statement('self.uf.append(rv)'),
                  py.Ret('rv')
              ]),
              py.Compound('def find(self, i)', [
                  py.Statement('j = self.uf[i]'),
                  py.Statement('while self.uf[j] != j: self.uf[i], j, i = self.uf[j], self.uf[j], j'),
                  py.Ret('j')
              ]),
              py.Compound('def union(self, i, j)', [
                  py.Statement('i = self.find(i); j = self.find(j)'),
                  py.Statement('if i != j: self.uf[i] = j'),
                  py.Ret('j')
              ]),
              py.Compound('def makeStr(self, s)', [
                  py.Statement('if s in self.str2handle: return self.str2handle[s]'),
                  py.Statement('rv = self.make()'),
                  py.Statement('self.handle2str[rv] = s'),
                  py.Statement('self.str2handle[s] = rv'),
                  py.Ret('rv')
              ]),
              py.Compound('def findStr(self, i)', [
