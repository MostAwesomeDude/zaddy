.syntax ZADDY

OUT1 = '*'     .out('ob += tb' .nl)
     / STRING  .out('ob += ' 39 * 39 .nl)
     / NUMBER  .out('ob += chr(' * ')' .nl)
     / '.lm+'  .out('ms[-1] += 1' .nl)
     / '.lm-'  .out('if ms[-1]: ms[-1] -= 1' .nl)
     / '.lm?'  .out('ms.append(ms[-1])' .nl)
     / '.lm!'  .out('ms.pop()' .nl)
     / '.nl'   .out(
       'lb += " " * (ms[-1] * 4) + ob + chr(10)' .nl
       'ob = ""' .nl
     ) ;
OUTPUT = '.out' '(' $OUT1 ')' ;

CX3 = NUMBER / SQUOTE .litchr ;
CX2 = CX3 ( ':' .out(* ' <= ord(self.s[i]) <= ') CX3 .out(*)
          / .empty .out('ord(self.s[i]) == ' *) ) ;
CX1 = .out('pf = (i < len(self.s)) and ') CX2
      $( '!' .out(' or ') CX2 ) .out(.nl) .post { ?pf } ;

SCAN = .pre { +pf } {
         .pre { +tf } { .out('tb += self.s[i]' .nl) }
         .pre { ?tf } { .out('if tf: tb += self.s[i]' .nl) }
         .out('i += 1' .nl)
       }
       .pre { ?pf } {
         .out('if pf:' .nl .lm+)
         .pre { +tf } { .out('tb += self.s[i]' .nl) }
         .pre { ?tf } { .out('if tf: tb += self.s[i]' .nl) }
         .out('i += 1' .nl .lm-)
       } ;
SUB = ID .out(
        'rv = self.parse' * '(i, tf, ms[:], tb, ob, lb)' .nl
        'pf = rv is not failed' .nl
        'if pf: i, ms[-1], tb, ob, lb = rv.t' .nl
      ) .top ;

SET = .pre { ~+pf } { .out('pf = True' .nl) } .post { +pf } ;

SAVE = .out('saved.append((i, tf, ms[-1], tb, ob, lb))' .nl) ;
BACKUP = .out('i, tf, ms[-1], tb, ob, lb = saved[-1]' .nl) ;
COMMIT = .out('saved.pop()' .nl) ;

TX3 = ( '.token'
        .out('tb = ""' .nl)
        .pre { ~+tf } { .out('tf = True' .nl) } .post { +tf }
      / '.tokout'
        .pre { ~-tf } { .out('tf = False' .nl) } .post { -tf }
      / '$' SET .out('while pf:' .nl .lm+) .post { +pf } TX3 .out(.lm-) .post { -pf } ) SET
    / '.empty' SET
    / '.not(' CX1 ')' .out('pf = (i < len(self.s)) and not pf' .nl) .post { ?pf } SCAN
    / '.any(' CX1 ')' SCAN
    / SUB
    / '(' TX1 ')' ;
TX2 = .out(.lm?) TX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf }
      $( TX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf } )
      .out(.lm!) ;
TX1 = SAVE TX2
      $( '/' .out('if not pf:' .nl .lm+) .post { -pf }
         BACKUP TX2 .post { ?pf } .out(.lm-) ) COMMIT ;
TR = ID .out(
       'def parse' * '(self, i, tf, ms, tb, ob, lb):' .nl .lm+
       'k = "' * '", i, tf, ms[-1], tb, ob, lb' .nl
       'if k in self.cache: return self.cache[k]' .nl
       'self.cache[k] = failed' .nl
       'saved = []' .nl
     )
     ':' .top SET TX1 ';'
     .out(
       'if pf:' .nl .lm+
       'self.cache[k] = Succeeded((i, ms[-1], tb, ob, lb))' .nl
       'self.lastMatch = k[0], k[1]' .nl .lm-
       'return self.cache[k]' .nl .lm-
     ) ;

TVAR = '~' .out('(not ') TVAR .out(')')
     / '?' ID .out('(self.a' * ' == 0)')
     / '+' ID .out('(self.a' * ' == 1)')
     / '-' ID .out('(self.a' * ' == 2)') ;
AVAR = '?' ID .out('self.a' * ' = 0' .nl)
     / '+' ID .out('self.a' * ' = 1' .nl)
     / '-' ID .out('self.a' * ' = 2' .nl) ;
EX3 = SUB
    / STRING .out(
      'while i < len(self.s) and self.s[i] in (" " + chr(10)): i += 1' .nl
      'stop = i + len("' * '")' .nl
      'if stop > len(self.s): pf = False' .nl
      'else: pf = self.s[i:stop] == "' * '"' .nl
      'if pf: i = stop' .nl
    ) .post { ?pf }
    / '(' EX1 ')'
    / '.pre' '{' .out('if ') TVAR
      $( ',' .out(' and ') TVAR ) .out(':' .nl .lm+ 'pass' .nl) '}'
      '{' EX1 '}' .out(.lm-)
    / '.post' '{' AVAR $( ',' AVAR ) '}'
    / '.fork'
    / '.join'
    / '.top' .out('self.top()' .nl)
    / '.empty' SET
    / '.litchr' SET .out(
      'tb = str(ord(self.s[i]))' .nl
      'i += 1' .nl
    )
    / '.pass' .out('i = 0' .nl)
    / '$' SET .out('while pf:' .nl .lm+) .post { +pf }
      EX3 .out(.lm-) .post { -pf } SET ;
EX2 = .out(.lm?)
      ( EX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf } / OUTPUT )
      $( EX3 .out('if pf:' .nl .lm+ 'pass' .nl) .post { +pf } / OUTPUT )
      .out(.lm!) .post { ?pf } ;
EX1 = SAVE EX2
      $( '/' .out('if not pf:' .nl .lm+) .post { -pf }
         BACKUP EX2 .post { ?pf } .out(.lm-) ) COMMIT ;

PR = ID .out(
       'def parse' * '(self, i, tf, ms, tb, ob, lb):' .nl .lm+
       'k = "' * '", i, tf, ms[-1], tb, ob, lb' .nl
       'if k in self.cache: return self.cache[k]' .nl
       'self.cache[k] = failed' .nl
       'saved = []' .nl
     )
     '=' .top SET EX1 ';'
     .out(
       'if pf:' .nl .lm+
       'self.cache[k] = Succeeded((i, ms[-1], tb, ob, lb))' .nl
       'self.lastMatch = k[0], k[1]' .nl .lm-
       'return self.cache[k]' .nl .lm-
     ) ;

TY = 'bool' .out('0') ;
DR = ID ':' .out('self.a' * ' = ') TY ';' .out(.nl) ;

ZADDY = '.syntax' ID .out(
          'from rpython.rlib.rfile import create_stdio' .nl
          'def target(driver, *args):' .nl .lm+
          'driver.exe_name = "' * '".lower() + "c"' .nl
          'return main, None' .nl .lm-
          'class Status(object): pass' .nl
          'class Failed(Status): pass' .nl
          '# i, ms[-1], tb, ob, lb' .nl
          'class Succeeded(Status):' .nl .lm+
          'def __init__(self, t): self.t = t' .nl .lm-
          'failed = Failed()' .nl
          'def main(argv):' .nl .lm+
          'stdin, stdout, stderr = create_stdio()' .nl
          'parser = ' * 'Parser(stdin.read())' .nl
          'status = parser.parse()' .nl
          'if status is failed:' .nl .lm+
          'stderr.write(("Last successful match:' 39 '%s, %d' 39 '" % parser.lastMatch) + chr(10))' .nl
          'return 1' .nl .lm-
          'else:' .nl .lm+
          '_, _, _, _, lb = status.t' .nl
          'stdout.write(lb)' .nl
          'return 0' .nl .lm- .lm-
          'class ' * 'Parser(object):' .nl .lm+
          'lastMatch = "", 0' .nl
          'def __init__(self, s): self.s = s; self.cache = {}; self.top()' .nl
          'def parse(self):' .nl .lm+
          'self.top()' .nl
          '# i, tf, ms, tb, ob, lb' .nl
          'return self.parse' * '(0, False, [0], "", "", "")' .nl .lm-
        )
        $PR '.tokens' $TR
        .out('def top(self):' .nl .lm+ 'pass' .nl)
        '.domain' $DR .out(.lm-)
        ( '.semantics' / .empty )
        ( '.tiles' / .empty )
        '.end' ;

.tokens

WS     : $.any(9!10!13!32) ;
DIGIT  : .any('0:'9) ;
ALPHA  : .any('A:'Z!'a:'z) ;
SQUOTE : WS .any(39) ;
STRING : WS .any(39) .token $.not(10!13!39) .tokout .any(39) ;
NUMBER : WS .token DIGIT $DIGIT .tokout ;
ID     : WS .token ALPHA $( ALPHA / DIGIT ) .tokout ;

.domain

pf : bool ;
tf : bool ;

.end
