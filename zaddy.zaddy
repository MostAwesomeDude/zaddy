.functor py

Statement(line)          -> [.line(line)] ;
Ret(expr)                -> [.line('return ' expr)] ;
RaiseIf(test)            -> [.line('if ' test ': raise ParseError()')] ;
Compound(head, block)    -> .if (block)
                            .then [.line(head ':'), .block(block)]
                            .else [.line(head ': pass')] ;
Conditional(test, block) -> .if (block)
                            .then [.line('if ' test ':'), .block(block)]
                            .else [] ;
Handler(block, handler)  -> .if (block) .then
                                .if (handler)
                                .then [.line('try:'), .block(block), .line('except ParseError:'), .block(handler)]
                                .else (*block)
                            .else [] ;

.functor production

Con(ty, con, prods) -> ty '.' con '(' (prods % ', ') ')' ;
PlusMany(ps)        -> ps % ' + ' ;
Mod(left, right)    -> right '.join(' left ')' ;
Flatten(l)          -> 'flatten(' l ')' ;
Name(s)             -> s ;
String(s)           -> 39 s 39 ;
List(prods)         -> '[' (prods % ', ') ']' ;
Length(s)           -> 'str(len(' s '))' ;
Chr(n)              -> 'chr(' n ')' ;
Cond(t, c, o)       -> '(' c ') if ' t ' else (' o ')' ;

.functor peg

let save       := py.Statement('st.append(i)') ;
let backup     := py.Statement('i = st.pop()') ;
let boundcheck := py.RaiseIf('i >= len(self.s)') ;

Null                    -> [] ;
AnyChar                 -> [boundcheck, py.Statement('rv = self.s[i]; i += 1')] ;
Char(i)                 -> [boundcheck,
                            py.RaiseIf('ord(self.s[i]) != ' i),
                            py.Statement('rv = self.s[i]; i += 1')] ;
Range(l, u)             -> [boundcheck,
                            py.RaiseIf('not (' l ' <= ord(self.s[i]) <= ' u ')'),
                            py.Statement('rv = self.s[i]; i += 1')] ;
Token(s)                -> [boundcheck,
                            py.Statement('while i < len(self.s) and ord(self.s[i]) in [9, 10, 13, 32]: i += 1'),
                            boundcheck,
                            py.RaiseIf('self.s[i:i + ' #s '] != "' s '"'),
                            py.Statement('self.lastMatch.append(("TOKEN ' s '", i, i + ' #s '))'),
                            py.Statement('rv = "' s '"; i += ' #s)] ;
Call(s)                 -> [py.Statement('i, rv = self.parse' s '(i)')] ;
Sequence(exprs)         -> *exprs ;
Choice(this, that)      -> [save, py.Handler(this, [backup] that)] ;
Any(expr)               -> [py.Statement('rvs = []'),
                            py.Compound('while True',
                                [save,
                                 py.Handler(expr [py.Statement('rvs.append(rv)')],
                                            [backup, py.Statement('break')])]),
                            py.Statement('rv = rvs')] ;
Some(expr)              -> [py.Statement('rvs = []'),
                            py.Compound('while True',
                                [save,
                                 py.Handler(expr [py.Statement('rvs.append(rv)')],
                                            [backup, py.Statement('break')])]),
                            py.Statement('rv = rvs'),
                            py.RaiseIf('not rv')] ;
Maybe(expr)             -> [save, py.Handler(expr, [py.Statement('rv = peg.Null()'), backup])] ;
Positive(expr)          -> [save,
                            py.Handler(expr [py.Statement('rv = True')],
                                       [py.Statement('rv = False')]),
                            backup,
                            py.RaiseIf('not rv')] ;
Negative(expr)          -> [save,
                            py.Handler(expr [py.Statement('rv = True')],
                                       [py.Statement('rv = False')]),
                            backup,
                            py.RaiseIf('rv')] ;
Capture(expr, name)     -> expr [py.Statement(name ' = rv')] ;
Production(expr, prod)  -> expr [py.Statement('rv = ' prod)] ;

.functor rules

Fact(t)                      -> '# ' t ;
Clause(t, goal)              -> '# ' t (goal % '') ;
Rule(name, r)                -> '# ' name '@' r ;
True                         -> 'true' ;
Eq(l, r)                     -> l '=' r ;
Ignore                       -> '_' ;
Var(n)                       -> n ;
Const(n)                     -> n ;
Compound(func, vars)         -> ([func] vars) % '' ;
Propagate(head, guard, goal) -> (['Propagate('] head [', ' guard ', '] goal [')']) % '' ;
Simplify(head, guard, goal)  -> (['Simplify('] head [', ' guard ', '] goal [')']) % '' ;
Simpagate(keep, discard, guard, goal) -> (['Simpagate('] keep discard [', ' guard ', '] goal [')']) % '' ;

.rules

.constraints zero/0, succ/2, gte/2, max/3,
             root/2, link/2, branch/2,
             make/1, union/2, find/2.

gte(N, zero).
gte(N, M) :- succ(X, N), succ(Y, M), gte(X, Y).

maxLeft   @ max(N, zero, M) <=> N = M.
maxRight  @ max(N, M, zero) <=> N = M.
maxSucc   @ succ(X, L), succ(Y, N), succ(Z, M) \ max(L, N, M) <=>
            max(X, Y, Z).

make      @ make(A) <=> root(A, zero).
union     @ union(A, B) <=> find(A, X), find(B, Y), link(X, Y).
findNode  @ branch(A, B), find(A, X) <=> find(B, X), branch(A, X).
findRoot  @ root(A, _) \ find(A, X) <=> X = A.
linkEq    @ link(A, A) <=> true.
linkLeft  @ link(A, B), root(A, N), root(B, M) <=>
            gte(N, M) | branch(B, A), succ(M, M1), max(R, N, M1), root(A, R).
linkRight @ link(B, A), root(A, N), root(B, M) <=>
            gte(N, M) | branch(B, A), succ(M, M1), max(R, N, M1), root(A, R).

.grammar ZADDY

WS := ( 9 / 10 / 13 / 32 )* ;
DIGIT := .range(48:57) ;
UPPER := .range(65:90) ;
LOWER := .range(97:122) ;
ALPHA := UPPER / LOWER ;
ESCAPE := 92 92 -> 92 92
        / .any ;
STRING := WS 39 ( !( 10 / 13 / 39 ) ESCAPE )*:cs 39 -> cs % '' ;
NUMBER := WS DIGIT:d DIGIT*:ds -> ([d] ds) % '' ;
ID := WS ALPHA:c ( ALPHA / DIGIT )*:cs -> ([c] cs) % '' ;
PVAR := WS UPPER:x ( ALPHA / DIGIT )*:xs -> ([x] xs) % '' ;
PCONST := WS LOWER+:xs -> xs % '' ;

ZR := ID:name '='
      ( FIELDS:fs -> zephyr.Product(name, fs)
      / CONSTRUCTOR:con ( '|' CONSTRUCTOR )*:cons
        ( 'attributes' FIELDS )?:attrs -> zephyr.Sum(name, attrs, con, cons) ) ;
CONSTRUCTOR := ID:tag FIELDS?:args -> zephyr.Con(tag, args) ;
FIELDS := '(' FIELD:f ( ',' FIELD )*:fs ')' -> [f] fs ;
FIELD := ID:ty ID?:name '?' -> zephyr.Option(ty, name)
       / ID:ty ID?:name '*' -> zephyr.Sequence(ty, name)
       / ID:ty ID?:name     -> zephyr.Id(ty, name) ;

RULES := '.rules' CONSTRAINT:cs CHORN*:hs CHANDLER*:rs -> cs hs rs ;
CONSTRAINT := '.constraints' CFUNCTOR:f ( ',' CFUNCTOR )*:fs '.' -> [f] fs
            / -> [] ;
CFUNCTOR := ID:name '/' NUMBER:arity -> py.Statement('# declare ' name arity) ;
CHORN := CCOMPOUND:t '.'                  -> py.Statement(rules.Fact(t))
       / CCOMPOUND:t ':-' CGOALS:goal '.' -> py.Statement(rules.Clause(t, goal)) ;
CHANDLER := ID:name '@' CHRULE:r -> py.Statement(rules.Rule(name, r)) ;
CHRULE := CHEAD:head '==>' CGUARD:guard CGOALS:goal '.'                    -> rules.Propagate(head, guard, goal)
        / CHEAD:head '<=>' CGUARD:guard CGOALS:goal '.'                    -> rules.Simplify(head, guard, goal)
        / CHEAD:keep WS 92 CHEAD:discard '<=>' CGUARD:guard CGOALS:goal '.' -> rules.Simpagate(keep, discard, guard, goal) ;
CHEAD := CTERM:t ( ',' CTERM )*:ts -> [t] ts ;
CTERM := CCOMPOUND / CVAR ;
CCOMPOUND := ID:func '(' CHEAD:vars ')' -> rules.Compound(func, vars) ;
CVAR := '_'         -> rules.Ignore
      / PVAR:name   -> rules.Var(name)
      / PCONST:name -> rules.Const(name) ;
CGUARD := CGOAL:g '|' -> g
        / -> rules.True ;
CGOALS := CGOAL:g ( ',' CGOAL )*:gs -> [g] gs ;
CGOAL := 'true'            -> rules.True
       / CVAR:l '=' CVAR:r -> rules.Eq(l, r)
       / CTERM ;

PROD1 := '.if' PROD1:test '.then' PROD1:cons '.else' PROD1:other -> production.Cond(test, cons, other)
       / PROD2 ;
PROD2 := PROD3:this '%' PROD2:that -> production.Mod(this, that)
       / PROD3 ;
PROD3 := PROD4+:ps -> production.PlusMany(ps) ;
PROD4 := '*' PROD5:prod -> production.Flatten(prod)
       / '#' PROD5:prod -> production.Length(prod)
       / PROD5 ;
PROD5 := ID:ty '.' ID:con
         '(' PROD1:prod ( ',' PROD1 )*:prods ')' -> production.Con(ty, con, [prod] prods)
       / ID:ty '.' ID:con                        -> production.Con(ty, con, [])
       / '[]'                                    -> production.List([])
       / '.line(' PROD1:l ')'                    -> production.Con('builtin', 'Line', [l])
       / '.block(' PROD1:expr ')'                -> production.Con('builtin', 'Block', [expr])
       / '[' PROD1:expr ( ',' PROD1 )*:exprs ']' -> production.List([expr] exprs)
       / ID:s                                    -> production.Name(s)
       / STRING:s                                -> production.String(s)
       / NUMBER:n                                -> production.Chr(n)
       / '(' PROD1:prod ')'                      -> prod ;

FUNCTOR := '.functor' ID:name FLET*:lets FRULE*:rules
        -> lets [py.Compound('class ' name 'Functor(object)', rules),
                 py.Statement(name ' = ' name 'Functor()')] ;

FLET := 'let' ID:name ':=' PROD1:prod ';' -> py.Statement(name ' = ' prod) ;

FRULE := ID:tag FPATTS:patts '->' PROD1:prod ';'
      -> py.Compound('def ' tag '(self, ' (patts % ', ') ')',
             [py.Ret(prod)])
       / ID:tag '->' PROD1:prod ';'
      -> py.Compound('def ' tag '(self)',
             [py.Ret(prod)]) ;

FPATTS := '(' FPATT:p ( ',' FPATT )*:ps ')' -> [p] ps ;
FPATT := ID ;

GRAMMAR := '.grammar' ID:name PRULE*:rules
        -> [py.Compound('def target(driver, *args)',
               [py.Statement('driver.exe_name = "' name '".lower() + "c"'),
                py.Ret('main, None')]),
            py.Compound('class ' name 'Parser(object)',
               [py.Compound('def __init__(self, s)',
                    [py.Statement('self.s = s; self.lastMatch = []')]),
                py.Compound('def parse(self)',
                    [py.Ret('self.parse' name '(0)')])]
               *rules),
            py.Statement('MainParser = ' name 'Parser')] ;

PRULE := ID:name ':=' PEXPR1:expr ';'
       -> [py.Statement('@cached'),
           py.Compound('def parse' name '(self, i)',
           [py.Statement('st = []')] expr [py.Ret('i, rv')])] ;
PEXPR1 := PEXPR2:this '/' PEXPR1:that -> peg.Choice(this, that)
        / PEXPR2 ;
PEXPR2 := PEXPR3:exprs '->' PROD1:prod -> peg.Production(exprs, prod)
        / PEXPR3 ;
PEXPR3 := PEXPR4*:exprs -> peg.Sequence(exprs) ;
PEXPR4 := PEXPR5:expr ':' ID:name -> peg.Capture(expr, name)
        / PEXPR5 ;
PEXPR5 := '&' PEXPR6:expr -> peg.Positive(expr)
        / '!' PEXPR6:expr -> peg.Negative(expr)
        / PEXPR6 ;
PEXPR6 := PEXPR7:expr '*' -> peg.Any(expr)
        / PEXPR7:expr '+' -> peg.Some(expr)
        / PEXPR7:expr '?' -> peg.Maybe(expr)
        / PEXPR7 ;
PEXPR7 := '.range(' NUMBER:l ':' NUMBER:u ')' -> peg.Range(l, u)
        / '.any'                              -> peg.AnyChar
        / NUMBER:c                            -> peg.Char(c)
        / ID:name                             -> peg.Call(name)
        / STRING:s                            -> peg.Token(s)
        / '(' PEXPR1:expr ')'                 -> expr ;

ZADDY := WS ( RULES / FUNCTOR / GRAMMAR )*:clss WS
      -> [py.Statement('from rpython.rlib.rfile import create_stdio'),
          py.Statement('from rpython.rlib.objectmodel import specialize'),
          py.Compound('class Result(object)', []),
          py.Compound('class Failed(Result)', []),
          py.Statement('failed = Failed()'),
          py.Compound('def cached(f, cacheCount=[0])', [
              py.Statement('attr = "t" + str(cacheCount[0]); cacheCount[0] += 1'),
              py.Statement('name = f.__name__'),
              py.Statement('class CacheResult(Result):'),
              py.Statement('    def __init__(self, i, rv): setattr(self, attr, (i, rv))'),
              py.Statement('cache = {}'),
              py.Compound('def deco(self, i)', [
                  py.Statement('key = i'),
                  py.RaiseIf('key in cache and cache[key] is failed'),
                  py.Statement('elif key in cache: return getattr(cache[key], attr)'),
                  py.Statement('cache[key] = failed'),
                  py.Statement('i, rv = f(self, i)'),
                  py.Statement('cache[key] = CacheResult(i, rv)'),
                  py.Statement('self.lastMatch.append((name, key, i))'),
                  py.Ret('i, rv')
              ]),
              py.Statement('deco.__name__ = name'),
              py.Ret('deco')
          ]),
          py.Statement('@specialize.call_location()'),
          py.Compound('def flatten(xs)', [
              py.Statement('rv = []'),
              py.Statement('for x in xs: rv.extend(x)'),
              py.Ret('rv')
          ]),
          py.Compound('class Builtin(object)', []),
          py.Statement('class Line(Builtin):'),
          py.Statement('    def __init__(self, s): self.s = s'),
          py.Statement('    def out(self, m): return [" " * (m * 4) + self.s]'),
          py.Statement('class Block(Builtin):'),
          py.Statement('    def __init__(self, ls): self.ls = ls'),
          py.Statement('    def out(self, m): return flatten([l.out(m + 1) for l in flatten(self.ls)])'),
          py.Statement('class Builder(object):'),
          py.Statement('    def Line(self, s): return Line(s)'),
          py.Statement('    def Block(self, ls): return Block(ls)'),
          py.Statement('builtin = Builder()'),
          py.Compound('class ParseError(Exception)', []),
          py.Compound('def lineNumber(s, i)', [py.Ret('s.count(chr(10), 0, i)')]),
          py.Compound('def main(argv)', [
              py.Statement('stdin, stdout, stderr = create_stdio()'),
              py.Statement('parser = MainParser(stdin.read())'),
              py.Handler([
                  py.Statement('i, rules = parser.parse()'),
                  py.Statement('if i != len(parser.s):'),
                  py.Statement('    stderr.write("Failed to consume all input\\n")'),
                  py.Statement('    raise ParseError()'),
                  py.Statement('buf = []'),
                  py.Statement('for rule in flatten(rules): buf.extend(rule.out(0))'),
                  py.Statement('stdout.write("\\n".join(buf))'),
                  py.Statement('stderr.write("Wrote %d lines to stdout\\n" % len(buf))'),
                  py.Ret('0')
              ], [
                  py.Statement('start = max(len(parser.lastMatch) - 25, 0)'),
                  py.Statement('newlines = [0]'),
                  py.Statement('for line in parser.s.split("\\n"):'),
                  py.Statement('    newlines.append(newlines[-1] + len(line) + 1)'),
                  py.Statement('for k, start, stop in parser.lastMatch[start:]:'),
                  py.Statement('    startLine = lineNumber(parser.s, start)'),
                  py.Statement('    startCol = start - newlines[startLine]'),
                  py.Statement('    stopLine = lineNumber(parser.s, stop)'),
                  py.Statement('    stopCol = stop - newlines[stopLine]'),
                  py.Statement('    t = k, startLine + 1, startCol, stopLine + 1, stopCol'),
                  py.Statement('    stderr.write(("Trail: %s (%d:%d - %d:%d)" % t) + chr(10))'),
                  py.Ret('1')
              ])
          ])]
         *clss ;
