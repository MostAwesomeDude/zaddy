.syntax JSON

JSON = .out('def parseJSONOntoDomain(d):' .nl .lm+ 'return ') ELEMENT .out(.nl) ;

VALUE = OBJECT
      / ARRAY
      / STRING .out('d.string(' * ')')
      / NUMBER
      / 'true' .out('d.true()')
      / 'false' .out('d.false()')
      / 'null' .out('d.null()') ;

OBJECT = '{' WS
         ( '}' .out('d.object({})')
         / .out('d.object({' .nl .lm+) MEMBERS '}' .out(.lm- '})') ) ;

MEMBERS = MEMBER $( ',' MEMBER ) ;

MEMBER = WS STRING WS ':' .out(* ': ') ELEMENT .out(',' .nl) ;

ARRAY = '[' WS
        ( ']' .out('d.array([])')
        / .out('d.array([' .nl .lm+) ELEMENTS ']' .out(.lm- '])') ) ;

ELEMENTS = ELEMENT .out(',' .nl) $( ',' ELEMENT .out(',' .nl) ) ;

ELEMENT = WS VALUE WS ;

NUMBER = INTEGER
         ( '.' .out('d.fraction(math.ldexp(' * '.')
           DIGITS .out(* ', ') E SIGN DIGITS .out(* '))')
         / .empty .out('d.number(' * ')') ) ;

.tokens

STRING  : .token .any('") $( .any('\) ESCAPE / .not('") ) .any('") .tokout ;
ESCAPE  : .any('"!'\!'/!'b!'f!'n!'r!'t) / .any('u) HEX4 ;
HEX4    : .any('0:'9!'A:'F!'a:'f) .any('0:'9!'A:'F!'a:'f)
          .any('0:'9!'A:'F!'a:'f) .any('0:'9!'A:'F!'a:'f) ;

INTEGER : .token ( .any('-) / .empty ) ( DIGIT / ONENINE DIGIT $DIGIT ) .tokout ;
DIGITS  : .token DIGIT $DIGIT .tokout ;
DIGIT   : .any('0) / ONENINE ;
ONENINE : .any('1:'9) ;

SIGN    : .any('-!'+) ;
E       : .any('e!'E) ;

WS      : $.any(9!10!13!32) ;

.domain

.end
