.functor bf

Right(n)    -> ['ptr +=' n ';'] ;
Left(n)     -> ['ptr -=' n ';'] ;
Plus(n)     -> ['*ptr +=' n ';'] ;
Minus(n)    -> ['*ptr -=' n ';'] ;
Output      -> ['putchar(*ptr);' ';'] ;
Input       -> ['*ptr = getchar();' ';'] ;
Loop(exprs) -> ['while (*ptr) {'] *exprs ['};'] ;
Program(p)  -> ['#include <stdio.h>',
                '#include <stdlib.h>',
                'int main(int argc, char **argv) {',
                'unsigned char *ptr = calloc(30 * 1000, 1);',
                'if (!ptr) {',
                'fprintf(stderr, "Error allocating memory.\\n");',
                'return 1;',
                '}'] p ['free(ptr);',
                'return 0;',
                '}'] ;

.grammar BF

BF := SQN:p -> bf.Program(p) ;
SQN := ( COMMENT OP )*:ops -> *ops ;
OP := '>'+:cs -> bf.Right(#cs)
    / '<'+:cs -> bf.Left(#cs)
    / '+'+:cs -> bf.Plus(#cs)
    / '-'+:cs -> bf.Minus(#cs)
    / '.'     -> bf.Output
    / ','     -> bf.Input
    / '[' SQN:exprs ']' -> bf.Loop(exprs) ;
COMMENT := ( !( '>' / '<' / '+' / '-' / '.' / ',' / '[' / ']' ) .any )* ;
